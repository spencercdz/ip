<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane prefHeight="620.0" prefWidth="680.0" styleClass="app-shell" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="jaku.ui.MainWindow">
  <top>
    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="app-header">
      <Label styleClass="app-mark" text="J" />
      <VBox spacing="2.0">
        <Label styleClass="app-title" text="Jaku" />
        <Label styleClass="app-subtitle" text="Your focused task companion" />
      </VBox>
    </HBox>
  </top>
  <center>
    <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" styleClass="conversation-scroll">
      <content><VBox fx:id="dialogContainer" spacing="12.0" styleClass="conversation" /></content>
    </ScrollPane>
  </center>
  <bottom>
    <AnchorPane styleClass="composer">
      <children>
        <TextField fx:id="userInput" onAction="#handleUserInput" promptText="Try: todo finish the report" styleClass="command-input" AnchorPane.bottomAnchor="12.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="104.0" AnchorPane.topAnchor="12.0" />
        <Button mnemonicParsing="false" onAction="#handleUserInput" styleClass="send-button" text="Send" AnchorPane.bottomAnchor="12.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="12.0" />
      </children>
    </AnchorPane>
  </bottom>
</BorderPane>
