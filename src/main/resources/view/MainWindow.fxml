<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="jaku.ui.MainWindow">
  <children>
    <ScrollPane fx:id="scrollPane" fitToWidth="true" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="48.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"><content><VBox fx:id="dialogContainer" spacing="8.0"/></content></ScrollPane>
    <TextField fx:id="userInput" onAction="#handleUserInput" promptText="Enter a command" AnchorPane.bottomAnchor="8.0" AnchorPane.leftAnchor="8.0" AnchorPane.rightAnchor="82.0"/>
    <Button mnemonicParsing="false" onAction="#handleUserInput" text="Send" AnchorPane.bottomAnchor="8.0" AnchorPane.rightAnchor="8.0"/>
  </children>
</AnchorPane>
